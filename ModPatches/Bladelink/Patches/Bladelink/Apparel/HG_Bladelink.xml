<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Bladelink</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="HG_Bladelink"]/statBases</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="HG_Bladelink"]</xpath>
            <value>
              <statBases />
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="HG_Bladelink"]/statBases</xpath>
          <value>
            <statBases>
              <MaxHitPoints>190</MaxHitPoints>
              <Flammability>0.25</Flammability>
              <DeteriorationRate>2</DeteriorationRate>
              <Beauty>-3</Beauty>
              <WorkToMake>15750</WorkToMake>
              <Mass>3</Mass>
              <ArmorRating_Sharp>0.01</ArmorRating_Sharp>
              <ArmorRating_Blunt>0.01</ArmorRating_Blunt>
              <ArmorRating_Heat>0</ArmorRating_Heat>
              <Insulation_Cold>0</Insulation_Cold>
              <Insulation_Heat>0</Insulation_Heat>
              <EquipDelay>2</EquipDelay>
              <Bulk>4</Bulk>
              <WornBulk>1</WornBulk>
              <NightVisionEfficiency_Apparel>0.8</NightVisionEfficiency_Apparel>
            </statBases>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="HG_Bladelink"]</xpath>
          <value>
            <li Class="CombatExtended.PartialArmorExt">
              <stats>
                <li>
                  <ArmorRating_Sharp>0.7</ArmorRating_Sharp>
                  <parts>
                    <li>Eye</li>
                  </parts>
                </li>
                <li>
                  <ArmorRating_Blunt>0.7</ArmorRating_Blunt>
                  <parts>
                    <li>Eye</li>
                  </parts>
                </li>
                <li>
                  <ArmorRating_Sharp>0.5</ArmorRating_Sharp>
                  <parts>
                    <li>Nose</li>
                    <li>Jaw</li>
                  </parts>
                </li>
                <li>
                  <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
                  <parts>
                    <li>Nose</li>
                    <li>Jaw</li>
                  </parts>
                </li>
              </stats>
            </li>
          </value>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="HG_Bladelink"]/equippedStatOffsets</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="HG_Bladelink"]</xpath>
            <value>
              <equippedStatOffsets />
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="HG_Bladelink"]/equippedStatOffsets</xpath>
          <value>
            <equippedStatOffsets>
              <MeleeHitChance>0.6</MeleeHitChance>
              <MeleeDodgeChance>15</MeleeDodgeChance>
            </equippedStatOffsets>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>